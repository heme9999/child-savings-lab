---
import { checkEligibility } from '../lib/eligibility/checkEligibility';

const initial = checkEligibility({
  checkYear: 2026,
  birthDate: '',
  hasEmploymentValidSsn: null,
  isUsCitizen: null,
  accountStatus: 'unknown',
  claimAuthority: 'guardian-or-legal-custodian',
  pilotElectionStatus: 'not-made',
  qualifyingChildExpected: null
});
---
<div class="tool-layout" data-eligibility-checker>
  <section class="tool-panel" aria-labelledby="eligibility-form-title">
    <div class="eyebrow">Private by design</div>
    <h2 id="eligibility-form-title">Check the next step</h2>
    <p>Check official account status before considering a new Form 4547 account election.</p>
    <form id="eligibility-form" novalidate>
      <div id="eligibility-errors"></div>
      <div class="form-grid">
        <div class="field">
          <label for="check-year">Review year</label>
          <input id="check-year" name="checkYear" type="number" min="2026" max="2100" value="2026" aria-describedby="review-year-help" required />
          <small id="review-year-help">Year being reviewed, not necessarily the year an existing account was first established.</small>
        </div>
        <div class="field">
          <label for="birth-date">Child’s date of birth</label>
          <input id="birth-date" name="birthDate" type="date" required />
        </div>
        <fieldset class="field full">
          <legend>Was the child’s SSN valid for employment and issued before the relevant election?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="hasEmploymentValidSsn" value="true" /> Yes</label>
            <label class="radio-option"><input type="radio" name="hasEmploymentValidSsn" value="false" /> No</label>
            <label class="radio-option"><input type="radio" name="hasEmploymentValidSsn" value="unknown" checked /> Not sure yet</label>
          </div>
        </fieldset>
        <div class="field full">
          <label for="account-status">What is the official account status?</label>
          <select id="account-status" name="accountStatus" required>
            <option value="unknown" selected>Unknown — I have not checked</option>
            <option value="auto-account">Treasury auto account exists but has not been claimed</option>
            <option value="claim-started">Auto-account claim started; receiving account not activated</option>
            <option value="manual-election-only">Form 4547 election made; account not activated</option>
            <option value="active-account">Claimed or other receiving account is activated</option>
            <option value="no-account-confirmed">IRS confirms no account or prior election</option>
          </select>
        </div>
        <div class="field full">
          <label for="claim-authority">Who would claim an auto account?</label>
          <select id="claim-authority" name="claimAuthority" required>
            <option value="guardian-or-legal-custodian">Guardian or legal custodian with property-management authority</option>
            <option value="beneficiary-with-legal-capacity">Beneficiary with legal capacity under state law</option>
            <option value="not-sure" selected>Not sure / relationship alone has not been legally confirmed</option>
          </select>
          <small>A parent or relative is not automatically authorized unless applicable law gives the required authority.</small>
        </div>
        <fieldset class="field full">
          <legend>Is the child a U.S. citizen?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="isUsCitizen" value="true" /> Yes</label>
            <label class="radio-option"><input type="radio" name="isUsCitizen" value="false" /> No</label>
            <label class="radio-option"><input type="radio" name="isUsCitizen" value="unknown" checked /> Not sure yet</label>
          </div>
        </fieldset>
        <fieldset class="field full">
          <legend>Do you expect the child to be your qualifying child for the pilot-election year?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="qualifyingChildExpected" value="true" /> Yes</label>
            <label class="radio-option"><input type="radio" name="qualifyingChildExpected" value="false" /> No</label>
            <label class="radio-option"><input type="radio" name="qualifyingChildExpected" value="unknown" checked /> Not sure yet</label>
          </div>
        </fieldset>
        <div class="field full">
          <label for="pilot-status">Status of the separate $1,000 pilot election</label>
          <select id="pilot-status" name="pilotElectionStatus" required>
            <option value="not-made">Not made</option>
            <option value="submitted-pending">Submitted, but not confirmed as processed</option>
            <option value="processed">Processed</option>
            <option value="unknown" selected>Unknown</option>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button class="button" type="submit" disabled>Show next steps</button>
        <button class="button secondary" type="reset">Reset</button>
      </div>
    </form>
    <div class="privacy-note"><span aria-hidden="true">◉</span><span>No names, Social Security numbers, addresses, or tax IDs are requested. Inputs stay in this browser and are not saved.</span></div>
    <noscript><p class="privacy-note">Enable JavaScript to run this checker locally. No eligibility assessment is made until you complete the required information; your inputs are not submitted.</p></noscript>
  </section>
  <section class="result-panel" aria-labelledby="eligibility-results-title" aria-live="polite" aria-atomic="true">
    <div class="eyebrow" style="color:#9ed5bf">Educational result</div>
    <h2 id="eligibility-results-title" tabindex="-1">Your next steps</h2>
    <p id="eligibility-state">No eligibility assessment yet. Complete the questions, then select Show next steps. Hypothetical answers are welcome.</p>
    <div id="eligibility-output" hidden>
    <div id="account-result">
      <h3>Account status</h3>
      <p><span class="status no">{initial.accountPathTitle}</span></p>
    </div>
    <div id="funding-result">
      <h3>Family or employer contributions</h3>
      <p><span class="status unknown">{initial.fundingGuidance}</span></p>
    </div>
    <div id="pilot-result">
      <h3>$1,000 pilot election</h3>
      <p><span class="status yes">{initial.pilotStatusTitle}</span></p>
    </div>
    <div id="eligibility-detail">
      <h3>Next steps</h3>
      <ul>{initial.requiredActions.map((action) => <li>{action}</li>)}</ul>
      <p><strong>Form 4547:</strong> {initial.formGuidance}</p>
    </div>
    </div>
    <p><strong>Logic and controlling rules checked:</strong> October 12, 2026. Individual source review dates appear in the source library.</p>
    <p><a href="https://www.irs.gov/trumpaccounts">Continue at the official IRS Trump Accounts page →</a></p>
  </section>
</div>

<script>
  import { checkEligibility } from '../lib/eligibility/checkEligibility';
  import { formNumber } from '../lib/calculators/form';
  import { formFeedback } from '../lib/forms/feedback';
  import { revealResult } from '../lib/forms/focus';
  import type { AccountStatus, ClaimAuthority, EligibilityInput, PilotElectionStatus } from '../lib/eligibility/types';

  const form = document.querySelector<HTMLFormElement>('#eligibility-form');
  const account = document.querySelector<HTMLElement>('#account-result');
  const funding = document.querySelector<HTMLElement>('#funding-result');
  const pilot = document.querySelector<HTMLElement>('#pilot-result');
  const detail = document.querySelector<HTMLElement>('#eligibility-detail');
  const errors = document.querySelector<HTMLElement>('#eligibility-errors');
  const feedback = form && errors ? formFeedback(form, errors) : null;
  const output = document.querySelector<HTMLElement>('#eligibility-output');
  const state = document.querySelector<HTMLElement>('#eligibility-state');
  const heading = document.querySelector<HTMLElement>('#eligibility-results-title');

  function boolValue(data: FormData, name: string): boolean | null {
    const value = data.get(name);
    return value === 'true' ? true : value === 'false' ? false : null;
  }

  function render(): void {
    if (!form || !account || !funding || !pilot || !detail || !errors || !output || !state) return;
    const data = new FormData(form);
    const input: EligibilityInput = {
      checkYear: formNumber(data.get('checkYear')),
      birthDate: String(data.get('birthDate') || ''),
      hasEmploymentValidSsn: boolValue(data, 'hasEmploymentValidSsn'),
      isUsCitizen: boolValue(data, 'isUsCitizen'),
      accountStatus: String(data.get('accountStatus')) as AccountStatus,
      claimAuthority: String(data.get('claimAuthority')) as ClaimAuthority,
      pilotElectionStatus: String(data.get('pilotElectionStatus')) as PilotElectionStatus,
      qualifyingChildExpected: boolValue(data, 'qualifyingChildExpected')
    };
    const result = checkEligibility(input);
    feedback?.clear();
    if (result.validationErrors.length) {
      output.hidden = true;
      state.textContent = 'More information is needed. Eligibility has not been assessed.';
      feedback?.show(result.validationIssues); return;
    }
    output.hidden = false;
    state.textContent = 'Account status and pilot eligibility are considered separately. These are educational next steps based on reported answers—not an IRS determination.';
    const list = (items: string[]) => items.length ? `<ul>${items.map((item) => `<li>${item}</li>`).join('')}</ul>` : '';
    account.innerHTML = `<h3>Account status</h3><p><span class="status ${result.accountPath === 'active' ? 'yes' : result.accountPath === 'not-baseline-eligible' ? 'no' : 'unknown'}">${result.accountPathTitle}</span></p>${list(result.accountReasons)}${list(result.accountInformationNeeded)}`;
    funding.innerHTML = `<h3>Family or employer contributions</h3><p><span class="status ${result.canReceiveFamilyOrEmployerContributions === true ? 'yes' : 'unknown'}">${result.fundingGuidance}</span></p>`;
    pilot.innerHTML = `<h3>$1,000 pilot election</h3><p><span class="status ${result.pilotStatus === 'potentially-eligible-to-elect' || result.pilotStatus === 'already-processed' ? 'yes' : result.pilotStatus === 'not-potentially-eligible' ? 'no' : 'unknown'}">${result.pilotStatusTitle}</span></p>${list(result.pilotReasons)}${list(result.pilotInformationNeeded)}`;
    detail.innerHTML = `<h3>Next steps</h3>${list(result.requiredActions)}<p><strong>Form 4547:</strong> ${result.formGuidance}</p>`;
    revealResult(heading);
  }

  form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
  const clearResult = () => {
    if (output) output.hidden = true;
    feedback?.clear();
    if (state) state.textContent = 'No eligibility assessment yet. Complete the questions, then select Show next steps.';
  };
  form?.addEventListener('input', clearResult);
  form?.addEventListener('reset', clearResult);
  form?.querySelector<HTMLButtonElement>('button[type="submit"]')?.removeAttribute('disabled');
</script>
