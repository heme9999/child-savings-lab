---
import { checkEligibility } from '../lib/eligibility/checkEligibility';

const initial = checkEligibility({
  applicationYear: 2026,
  birthDate: '2026-01-15',
  hasValidSsn: true,
  isUsCitizen: true,
  priorAccountElection: false,
  priorPilotElection: false,
  qualifyingChildExpected: true,
  relationship: 'parent'
});
---
<div class="tool-layout" data-eligibility-checker>
  <section class="tool-panel" aria-labelledby="eligibility-form-title">
    <div class="eyebrow">Private by design</div>
    <h2 id="eligibility-form-title">Check two kinds of eligibility</h2>
    <p>This tool evaluates an initial account election separately from the one-time $1,000 pilot contribution.</p>
    <div class="privacy-note"><span aria-hidden="true">◉</span><span>No names, Social Security numbers, addresses, or tax IDs are requested. Inputs stay in this browser and are not saved.</span></div>
    <form id="eligibility-form" novalidate>
      <div class="form-grid">
        <div class="field">
          <label for="application-year">Election year</label>
          <input id="application-year" name="applicationYear" type="number" min="2026" max="2100" value="2026" required aria-describedby="application-year-help" />
          <small id="application-year-help">The year Form 4547 will be submitted.</small>
        </div>
        <div class="field">
          <label for="birth-date">Child’s date of birth</label>
          <input id="birth-date" name="birthDate" type="date" value="2026-01-15" required />
        </div>
        <div class="field full">
          <label for="relationship">Your relationship to the child</label>
          <select id="relationship" name="relationship" required>
            <option value="parent" selected>Parent</option>
            <option value="legal-guardian">Legal guardian</option>
            <option value="adult-sibling">Adult sibling</option>
            <option value="grandparent">Grandparent</option>
            <option value="other">Other</option>
          </select>
        </div>
        <fieldset class="field full">
          <legend>Does the child have a valid SSN issued before the election?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="hasValidSsn" value="true" checked /> Yes</label>
            <label class="radio-option"><input type="radio" name="hasValidSsn" value="false" /> No</label>
          </div>
        </fieldset>
        <fieldset class="field full">
          <legend>Has an initial Trump Account election already been filed for this child?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="priorAccountElection" value="false" checked /> No</label>
            <label class="radio-option"><input type="radio" name="priorAccountElection" value="true" /> Yes</label>
          </div>
        </fieldset>
        <fieldset class="field full">
          <legend>Is the child a U.S. citizen?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="isUsCitizen" value="true" checked /> Yes</label>
            <label class="radio-option"><input type="radio" name="isUsCitizen" value="false" /> No</label>
          </div>
        </fieldset>
        <fieldset class="field full">
          <legend>Do you expect the child to be your qualifying child for the election year?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="qualifyingChildExpected" value="true" checked /> Yes</label>
            <label class="radio-option"><input type="radio" name="qualifyingChildExpected" value="false" /> No / unsure</label>
          </div>
        </fieldset>
        <fieldset class="field full">
          <legend>Has a pilot contribution election already been submitted or processed?</legend>
          <div class="radio-row">
            <label class="radio-option"><input type="radio" name="priorPilotElection" value="false" checked /> No</label>
            <label class="radio-option"><input type="radio" name="priorPilotElection" value="true" /> Yes</label>
          </div>
        </fieldset>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Check eligibility</button>
        <button class="button secondary" type="reset">Reset</button>
      </div>
    </form>
  </section>
  <section class="result-panel" aria-labelledby="eligibility-results-title" aria-live="polite" aria-atomic="true">
    <div class="eyebrow" style="color:#9ed5bf">Educational result</div>
    <h2 id="eligibility-results-title">Your potential result</h2>
    <div id="account-result">
      <h3>Initial account</h3>
      <p><span class="status yes">Potentially eligible</span></p>
    </div>
    <div id="pilot-result">
      <h3>$1,000 pilot contribution</h3>
      <p><span class="status yes">Potentially eligible</span></p>
    </div>
    <div id="eligibility-detail">
      <h3>Next steps</h3>
      <ul>{initial.requiredActions.map((action) => <li>{action}</li>)}</ul>
    </div>
    <p><strong>Form:</strong> IRS Form 4547</p>
    <p><strong>Rules checked:</strong> October 8, 2026</p>
    <p><a href="https://www.irs.gov/trumpaccounts">Continue at the official IRS Trump Accounts page →</a></p>
  </section>
</div>

<script>
  import { checkEligibility } from '../lib/eligibility/checkEligibility';
  import type { EligibilityInput, Relationship } from '../lib/eligibility/types';

  const form = document.querySelector<HTMLFormElement>('#eligibility-form');
  const account = document.querySelector<HTMLElement>('#account-result');
  const pilot = document.querySelector<HTMLElement>('#pilot-result');
  const detail = document.querySelector<HTMLElement>('#eligibility-detail');

  function boolValue(data: FormData, name: string): boolean {
    return data.get(name) === 'true';
  }

  function render(): void {
    if (!form || !account || !pilot || !detail) return;
    const data = new FormData(form);
    const input: EligibilityInput = {
      applicationYear: Number(data.get('applicationYear')),
      birthDate: String(data.get('birthDate') || ''),
      hasValidSsn: boolValue(data, 'hasValidSsn'),
      isUsCitizen: boolValue(data, 'isUsCitizen'),
      priorAccountElection: boolValue(data, 'priorAccountElection'),
      priorPilotElection: boolValue(data, 'priorPilotElection'),
      qualifyingChildExpected: boolValue(data, 'qualifyingChildExpected'),
      relationship: String(data.get('relationship')) as Relationship
    };
    const result = checkEligibility(input);
    const status = (yes: boolean) => `<span class="status ${yes ? 'yes' : 'no'}">${yes ? 'Potentially eligible' : 'Not eligible based on these answers'}</span>`;
    const list = (items: string[]) => items.length ? `<ul>${items.map((item) => `<li>${item}</li>`).join('')}</ul>` : '';
    account.innerHTML = `<h3>Initial account</h3><p>${status(result.canOpenAccount)}</p>${list(result.accountReasons)}`;
    pilot.innerHTML = `<h3>$1,000 pilot contribution</h3><p>${status(result.pilotContributionEligible)}</p>${list(result.pilotReasons)}`;
    detail.innerHTML = `<h3>Next steps</h3>${list(result.requiredActions)}`;
  }

  form?.addEventListener('submit', (event) => { event.preventDefault(); render(); });
  form?.addEventListener('reset', () => window.setTimeout(render));
</script>
