---
interface Props { kind: 'status' | 'growth' | 'compare'; }
const { kind } = Astro.props;
---
<svg class="goal-illustration" viewBox="0 0 144 100" fill="none" aria-hidden="true">
  {kind === 'status' && <>
    <circle cx="83" cy="48" r="39" fill="#d6e3cb"/>
    <rect x="35" y="19" width="60" height="68" rx="8" fill="#fffdf4" stroke="#245848" stroke-width="2.5"/>
    <path d="M48 38h32M48 48h22M48 59h16" stroke="#a5b8a3" stroke-width="3" stroke-linecap="round"/>
    <circle cx="96" cy="69" r="19" fill="#245848"/>
    <path d="m87 69 6 6 12-13" stroke="#fffdf4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M26 30v10M21 35h10M114 23v8M110 27h8" stroke="#9b7b37" stroke-width="2" stroke-linecap="round"/>
  </>}
  {kind === 'growth' && <>
    <circle cx="77" cy="46" r="38" fill="#f5d88c"/>
    <path d="M29 86h87" stroke="#8d634b" stroke-width="2.5" stroke-linecap="round"/>
    <rect x="38" y="65" width="18" height="21" rx="3" fill="#edb693" stroke="#8d634b" stroke-width="2"/>
    <rect x="65" y="48" width="18" height="38" rx="3" fill="#edb693" stroke="#8d634b" stroke-width="2"/>
    <rect x="92" y="26" width="18" height="60" rx="3" fill="#fffdf4" stroke="#8d634b" stroke-width="2"/>
    <path d="m36 47 26-16 19 2 20-19m-12 0h12v12" stroke="#245848" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M22 23v10M17 28h10" stroke="#8d634b" stroke-width="2" stroke-linecap="round"/>
  </>}
  {kind === 'compare' && <>
    <circle cx="70" cy="50" r="39" fill="#ddd8ec"/>
    <rect x="33" y="25" width="43" height="59" rx="6" transform="rotate(-9 33 25)" fill="#fffdf4" stroke="#61567b" stroke-width="2.5"/>
    <rect x="72" y="24" width="43" height="59" rx="6" transform="rotate(8 72 24)" fill="#e9e5f3" stroke="#61567b" stroke-width="2.5"/>
    <path d="m43 43 10-8 10 8M47 42v11h12V42M80 64l7-8 7 3 10-13M81 73h23" stroke="#61567b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M121 19v10M116 24h10" stroke="#9b7b37" stroke-width="2" stroke-linecap="round"/>
  </>}
</svg>
