---
import { formatReviewDate } from '../lib/dates';
interface Props { date: string; label: string; }
const { date, label } = Astro.props;
---
<div class="verified-badge" role="note">
  <span aria-hidden="true">✓</span>
  <span><strong>{label}:</strong> <time datetime={date} data-review-date>{formatReviewDate(date)}</time></span>
</div>
