---
interface Props { date?: string; effective?: string; }
const { date = 'October 8, 2026', effective = '2026 rules' } = Astro.props;
---
<div class="verified-badge" role="note">
  <span aria-hidden="true">✓</span>
  <span><strong>Last verified:</strong> {date}</span>
  <span><strong>Effective for:</strong> {effective}</span>
</div>
