---
interface Props {
  caption: string;
  columns: string[];
  rows: { label: string; href?: string; cells: string[] }[];
}
const { caption, columns, rows } = Astro.props;
if (rows.some((row) => row.cells.length !== columns.length - 1)) throw new Error('Comparison row does not match its column labels.');
---
<div class="comparison-desktop">
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead><tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr></thead>
    <tbody>{rows.map((row) => <tr>
      <th scope="row">{row.href ? <a href={row.href}>{row.label}</a> : row.label}</th>
      {row.cells.map((cell) => <td>{cell}</td>)}
    </tr>)}</tbody>
  </table>
</div>
<section class="comparison-mobile" aria-label={caption}>
  {rows.map((row) => <div class="comparison-card">
    <h3>{row.href ? <a href={row.href}>{row.label}</a> : row.label}</h3>
    <dl>{row.cells.map((cell, index) => <div><dt>{columns[index + 1]}</dt><dd>{cell}</dd></div>)}</dl>
  </div>)}
</section>
