---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="We couldn’t find this page. Return to Child Savings Lab’s guides and free tools to explore ways to save for a child." noindex>
  <section class="page-hero section">
    <div class="narrow">
      <div class="eyebrow">404 · Page not found</div>
      <h1>Let’s find your next step.</h1>
      <p class="lede">The page you’re looking for doesn’t exist or may have moved. You can still explore our guides and free tools.</p>
      <div class="hero-actions">
        <a class="button" href="/">Back to home</a>
        <a class="button secondary" href="/tools/child-savings-account-comparison/">Explore savings tools</a>
      </div>
      <p>Followed a broken link? <a href="/contact/">Let us know</a> so we can check it.</p>
    </div>
  </section>
</BaseLayout>
