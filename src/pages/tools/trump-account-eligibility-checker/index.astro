---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EligibilityChecker from '../../../components/EligibilityChecker.astro';
import SourceLinks from '../../../components/SourceLinks.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Trump Account Status and Eligibility Checker',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any web browser',
  isAccessibleForFree: true,
  description: 'Routes families through auto-account status, claiming, activation, contribution readiness, and the separate $1,000 pilot election.'
};
---
<BaseLayout title="Trump Account Status and Eligibility Checker" description="Check the next step for an auto account, claim, activation, private contributions, and the separate $1,000 pilot election." verifiedAt="2026-10-08">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Tools',href:'/tools/child-savings-account-comparison/'},{label:'Eligibility checker'}]} /></div>
  <header class="page-hero shell">
    <div class="eyebrow">Trump Account tool</div>
    <h1>Trump Account status and eligibility checker</h1>
    <p class="lede">Find the next step after Treasury auto enrollment—without entering names, SSNs, account numbers, or tax IDs.</p>
    <VerifiedBadge />
  </header>
  <div class="shell"><EligibilityChecker /></div>
  <section class="section tint">
    <div class="article-body shell">
      <h2>What changed on September 30, 2026</h2>
      <p>Temporary regulations introduced broad Treasury auto enrollment. The checker therefore tests baseline age and employment-valid SSN requirements, then routes the user through status checking, auto-account claiming, receiving-account activation, or the rare manual-election exception.</p>
      <p>The separate pilot result evaluates the 2025–2028 birth window, U.S. citizenship, qualifying-child expectation, and whether a pilot election is not made, pending, processed, or unknown. The IRS makes all determinations.</p>
      <SourceLinks ids={['TREASURY-TD-10056','IRS-FORM-4547-INSTRUCTIONS']} />
    </div>
  </section>
</BaseLayout>
