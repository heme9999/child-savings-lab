---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EligibilityChecker from '../../../components/EligibilityChecker.astro';
import SourceLinks from '../../../components/SourceLinks.astro';
import VerifiedBadge from '../../../components/VerifiedBadge.astro';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Trump Account Eligibility Checker',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any web browser',
  isAccessibleForFree: true,
  description: 'Checks potential eligibility for an initial Trump Account and the one-time $1,000 pilot contribution separately.'
};
---
<BaseLayout title="Trump Account Eligibility Checker" description="Check possible eligibility for an initial Trump Account and the $1,000 pilot contribution separately, with reasons and current IRS sources." verifiedAt="2026-10-08">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Tools',href:'/tools/child-savings-account-comparison/'},{label:'Eligibility checker'}]} /></div>
  <header class="page-hero shell">
    <div class="eyebrow">Trump Account tool</div>
    <h1>Trump Account eligibility checker</h1>
    <p class="lede">Get two answers: whether a child may qualify for an initial account and whether they may also qualify for the federal $1,000 pilot contribution.</p>
    <VerifiedBadge />
  </header>
  <div class="shell"><EligibilityChecker /></div>
  <section class="section tint">
    <div class="article-body shell">
      <h2>How this checker interprets the IRS rules</h2>
      <p>The account result tests year-end age, SSN, prior account election, and the relationship of the person filing. The pilot result then adds the 2025–2028 birth window, U.S. citizenship, qualifying-child expectation, and prior pilot election status.</p>
      <p>“Potentially eligible” is not approval. The IRS makes the determination, and complex custody, dependency, immigration, or SSN facts may require professional help.</p>
      <SourceLinks ids={['IRS-TRUMP-ACCOUNTS','IRS-FORM-4547-INSTRUCTIONS']} />
    </div>
  </section>
</BaseLayout>
