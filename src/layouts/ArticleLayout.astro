---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import SourceLinks from '../components/SourceLinks.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  sourceIds?: string[];
  verifiedAt?: string;
  effective?: string;
  summary?: string[];
  contents?: { id: string; label: string }[];
}

const {
  title,
  description,
  eyebrow = 'Independent family finance guide',
  sourceIds = [],
  verifiedAt = '2026-10-08',
  effective = '2026 rules',
  summary = [],
  contents = []
} = Astro.props;
---
<BaseLayout title={title} description={description} type="article" verifiedAt={verifiedAt}>
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
  </div>
  <article class="article">
    <header class="page-hero shell">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <ArticleMeta date={verifiedAt} effective={effective} />
    </header>
    <div class="article-body shell">
      {summary.length > 0 && <aside class="quick-summary" aria-label="At a glance"><strong>In 30 seconds</strong><ul>{summary.map((point) => <li>{point}</li>)}</ul></aside>}
      <slot name="overview" />
      {contents.length > 0 && <details class="article-contents print-hide"><summary>On this page <span>{contents.length} sections</span></summary><nav aria-label="On this page"><ol>{contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol></nav></details>}
      <slot />
      {sourceIds.length > 0 && <SourceLinks ids={sourceIds} />}
    </div>
  </article>
</BaseLayout>
